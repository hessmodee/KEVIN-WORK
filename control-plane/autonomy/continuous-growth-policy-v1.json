{
  "schema": 1,
  "kind": "kevin-continuous-growth-policy",
  "version": "1.0.0",
  "authority_effect": "NONE_POLICY_ONLY",
  "mission": "Continuously self-heal, self-maintain, self-improve, learn, recover blockers and create owner value using only already-authorized bounded capabilities and independently verified evidence.",
  "loop": [
    "OBSERVE",
    "DIAGNOSE",
    "REPAIR",
    "VERIFY",
    "MAINTAIN",
    "IMPROVE",
    "LEARN",
    "PROVE",
    "RECORD",
    "CONTINUE"
  ],
  "programs": [
    "self-heal",
    "self-maintenance",
    "self-improvement",
    "knowledge-integrity",
    "blocked-work-recovery",
    "capability-growth",
    "owner-value-scan"
  ],
  "protected_effects": [
    "arbitrary_shell",
    "credential_access",
    "credential_entry",
    "permission_widening",
    "external_send",
    "email_send",
    "public_post",
    "purchase",
    "financial_transaction",
    "live_crypto_trade",
    "file_delete",
    "destructive_overwrite",
    "software_install",
    "production_chat_send",
    "automatic_promotion",
    "safety_weakening",
    "governance_edit",
    "authority_boundary_change",
    "game_public_server_join",
    "game_public_chat",
    "pvp_real_player"
  ],
  "protected_target_prefixes": [
    "AGENTS.md",
    "docs/architecture/KEVIN-CONSTITUTION-v2.md",
